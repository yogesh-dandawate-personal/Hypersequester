{
  "environment": "production",
  "debug": false,
  "database": {
    "url": "${DATABASE_URL}",
    "pool_size": 20,
    "max_overflow": 30
  },
  "redis": {
    "url": "${REDIS_URL}"
  },
  "processing": {
    "default_pixel_size": 1.0,
    "max_concurrent_jobs": 8,
    "processing_timeout": 7200,
    "supported_formats": ["AVIRIS", "HySpex", "PRISMA", "EnMAP"]
  },
  "storage": {
    "upload_folder": "/app/data/uploads",
    "results_folder": "/app/data/results",
    "max_file_size_gb": 32
  },
  "logging": {
    "level": "INFO",
    "file": "/app/logs/hypersequester.log"
  },
  "security": {
    "jwt_expiration_hours": 8,
    "password_min_length": 12
  },
  "monitoring": {
    "enable_metrics": true,
    "metrics_port": 9090
  }
}
