{
  "name": "hypersequester",
  "version": "1.0.0",
  "description": "Hyperspectral forest carbon assessment platform",
  "main": "src/frontend/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:netlify": "REACT_APP_API_URL=https://hypersequester-api.herokuapp.com/api/v1 REACT_APP_DEMO_MODE=true npm run build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src/frontend --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src/frontend --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/frontend/**/*.{js,jsx,ts,tsx,css,md}",
    "analyze": "npm run build && npx bundle-analyzer build/static/js/*.js",
    "serve": "serve -s build -l 3000"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "leaflet": "^1.9.3",
    "react-leaflet": "^4.2.1",
    "axios": "^1.3.0",
    "recharts": "^2.5.0",
    "antd": "^5.2.0",
    "@ant-design/icons": "^5.0.1",
    "three": "^0.149.0",
    "@react-three/fiber": "^8.11.1",
    "@react-three/drei": "^9.56.0",
    "plotly.js": "^2.18.0",
    "react-plotly.js": "^2.6.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "classnames": "^2.3.2",
    "react-hook-form": "^7.43.0",
    "react-query": "^3.39.3",
    "zustand": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/leaflet": "^1.9.0",
    "@types/lodash": "^4.14.191",
    "@types/three": "^0.149.0",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.8.4",
    "typescript": "^4.9.5",
    "serve": "^14.2.0",
    "webpack-bundle-analyzer": "^4.8.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000"
}
